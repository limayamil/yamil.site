---
import '../styles/global.css';
import { meta } from '../data/profile';
import Bilingual from '../components/Bilingual.astro';
import SolarVeil from '../components/SolarVeil.astro';

interface Props {
  title?: string;
  description?: string;
}

// Spanish is what gets served, so it is what crawlers index. The English copy
// is in the page too and the inline script below swaps the visible language —
// but only `document.title` follows, since a client-side <meta> swap buys
// nothing a crawler will ever read.
const { title = meta.title.es, description = meta.description.es } = Astro.props;
const canonical = new URL(Astro.url.pathname, Astro.site ?? meta.url);
const ogImage = new URL('/og.png', Astro.site ?? meta.url);
---

<!doctype html>
<html lang="es" data-lang="es" data-title-es={meta.title.es} data-title-en={meta.title.en}>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonical} />

    <!-- The one script outside motion.ts, and the reason is timing: motion.ts
         is deferred, so a stored "en" preference would flash Spanish first.
         This has to resolve the language before the first paint. -->
    <script is:inline>
      (function () {
        var root = document.documentElement;
        var lang;
        try {
          lang = localStorage.getItem('lang');
        } catch (error) {
          // Storage blocked (private mode, hardened settings) — fall through
          // to the browser's own preference.
        }
        if (lang !== 'es' && lang !== 'en') {
          lang = (navigator.language || 'es').toLowerCase().indexOf('es') === 0 ? 'es' : 'en';
        }
        root.dataset.lang = lang;
        root.lang = lang;
        var title = root.getAttribute('data-title-' + lang);
        if (title) document.title = title;
      })();
    </script>

    <!-- Both faces are needed above the fold, so preload rather than let the
         CSS parser discover them. -->
    <link
      rel="preload"
      as="font"
      type="font/woff2"
      href="/fonts/inter-tight-latin-wght-normal.woff2"
      crossorigin
    />
    <link
      rel="preload"
      as="font"
      type="font/woff2"
      href="/fonts/instrument-serif-latin-400-normal.woff2"
      crossorigin
    />

    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <link rel="apple-touch-icon" href="/apple-touch-icon.png" />
    <meta name="theme-color" content="#120906" />
    <meta name="color-scheme" content="dark" />

    <meta property="og:type" content="website" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <meta property="og:image" content={ogImage} />
    <meta name="twitter:card" content="summary_large_image" />

    <link rel="sitemap" href="/sitemap-index.xml" />

    <!-- Reveals start hidden and are shown by JS; without it, show everything.
         Doodles start undrawn, so they need resolving the same way.

         The track record is the one view that also has to be *unhidden*: it is
         the left column's `#recorrido` state and only `motion.ts` ever switches
         to it, so with no script it would be a dead link over hidden content.
         Both views simply stack instead — the record is the page's, not the
         router's. (A case does not need this: it is one of nine, and showing
         all nine under the grid is not a fallback, it is a different page.) -->
    <noscript>
      <style>
        .intro[data-view='bio'] .track {
          display: flex !important;
        }

        .track-line::before {
          transform: none !important;
          animation: none !important;
        }

        /* Animation only — the bar's resting `scaleX(var(--span))` is the
           duration it is drawing, so `transform: none` here would report every
           job as the longest one. */
        .track-span-fill {
          animation: none !important;
        }

        [data-reveal],
        .enter,
        .track-enter {
          opacity: 1 !important;
          transform: none !important;
          animation: none !important;
        }

        [data-doodle] path {
          stroke-dasharray: none !important;
          stroke-dashoffset: 0 !important;
        }

        [data-doodle].doodle-wipe {
          clip-path: none !important;
        }
      </style>
    </noscript>
  </head>

  <body>
    <SolarVeil />
    <a class="skip-link" href="#work">
      <Bilingual es="Ir a los proyectos" en="Skip to work" />
    </a>
    <slot />
    <script src="../scripts/motion.ts"></script>
  </body>
</html>
