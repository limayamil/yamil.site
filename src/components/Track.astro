---
/**
 * The track record — the second state of the left-hand column.
 *
 * Deliberately the same construction as `ProjectDetail.astro` on the right:
 * rendered server-side, shipped inside the page, and switched by an attribute
 * that `motion.ts` flips off the `#recorrido` hash. No fetch, no template, no
 * second route. `.intro[data-view]` picks a view exactly the way
 * `.projects[data-view]` does.
 *
 * The one thing here that is not free-hand: **entries stagger with `--i`, not
 * `[data-reveal]`.** A reveal observer never fires for an element that has been
 * inside `display: none` since load — the same bug the case router hit from the
 * other direction — so the entrance is a CSS animation, which restarts on its
 * own every time the view is shown.
 *
 * Each node still carries the entry's `axis` (an sr-only label plus the glyph
 * from `Icon.astro`) — the same key a capability's `icon` and a project's
 * `axis` use, kept for whoever reaches for it next, even though nothing on this
 * view currently filters or highlights by it.
 */
import { profile } from '../data/profile';
import { track } from '../data/track';
import Bilingual from './Bilingual.astro';
import ExternalArrow from './ExternalArrow.astro';
import Icon from './Icon.astro';

const languages = ['es', 'en'] as const;

/**
 * Month names by hand rather than `Intl.DateTimeFormat`. ICU renders Spanish
 * short months with a trailing period and spells September "sept", so the
 * column would carry two different label widths for no reason. Twelve strings
 * twice is cheaper than styling around that.
 */
const MONTHS: Record<(typeof languages)[number], string[]> = {
  es: ['ene', 'feb', 'mar', 'abr', 'may', 'jun', 'jul', 'ago', 'sep', 'oct', 'nov', 'dic'],
  en: ['Jan', 'Feb', 'Mar', 'Apr', 'May', 'Jun', 'Jul', 'Aug', 'Sep', 'Oct', 'Nov', 'Dec'],
};

const PRESENT = { es: 'hoy', en: 'now' };

const parse = (iso: string): [number, number] => {
  const [year, month] = iso.split('-').map(Number);
  return [year, month];
};

const monthLabel = (iso: string, lang: (typeof languages)[number]) => {
  const [year, month] = parse(iso);
  return `${MONTHS[lang][month - 1]} ${year}`;
};

/**
 * Length in months. An open-ended entry is measured against the build date,
 * which means the current role's bar grows a pixel or so per rebuild — the one
 * thing on the page that is not byte-identical between builds, and the honest
 * behaviour for a bar that means "how long".
 */
const now = new Date();
const span = (start: string, end: string | null) => {
  const [ys, ms] = parse(start);
  const [ye, me] = end ? parse(end) : [now.getFullYear(), now.getMonth() + 1];
  return Math.max(1, (ye - ys) * 12 + (me - ms));
};

// Newest first. `start` descending, and a tie broken by the longer run, so a
// staff role sorts above a freelance one that began the same month.
const entries = [...track.entries].sort(
  (a, b) => b.start.localeCompare(a.start) || span(b.start, b.end) - span(a.start, a.end),
);

const axisTitle = (axis: string) =>
  profile.capabilities.find((capability) => capability.icon === axis)?.title ?? axis;

const stats = [
  { value: String(now.getFullYear() - track.since), label: { es: 'años', en: 'years' } },
  { value: String(entries.length), label: { es: 'roles', en: 'roles' } },
  {
    value: String(new Set(entries.map((entry) => entry.company)).size),
    label: { es: 'empresas', en: 'companies' },
  },
];
---

<section class="track" data-track aria-labelledby="track-title">
  <button type="button" class="case-back track-enter" style="--i:0" data-track-back>
    <svg width="14" height="14" viewBox="0 0 8 8" fill="none" aria-hidden="true">
      <path
        d="M5.25 1.25 2.25 4l3 2.75"
        stroke="currentColor"
        stroke-width="1.1"
        stroke-linecap="round"
        stroke-linejoin="round"></path>
    </svg>
    <Bilingual es="Volver" en="Back" />
  </button>

  <header class="track-head track-enter" style="--i:1">
    <p class="label"><Bilingual es="Recorrido" en="Track record" /></p>
    <h2 id="track-title" class="track-title display">
      <Bilingual es={track.title.es} en={track.title.en} />
    </h2>
    <p class="col-prose prose-tight text-muted">
      <Bilingual es={track.lead.es} en={track.lead.en} />
    </p>
  </header>

  {/* Same shape as `.case-metrics` on the other side of the page — three
      figures that say how big the record is before anyone reads it. */}
  <ul class="track-stats track-enter" style="--i:2">
    {
      stats.map((stat) => (
        <li>
          <span class="track-stat-value">{stat.value}</span>
          <span class="label track-stat-label">
            <Bilingual es={stat.label.es} en={stat.label.en} />
          </span>
        </li>
      ))
    }
  </ul>

  <ol class="track-line" data-track-line>
    {
      entries.map((entry, index) => (
        <li
          class="track-entry track-enter"
          style={`--i:${index + 4}`}
          data-axis={entry.axis}
          {...(entry.end === null ? { 'data-current': '' } : {})}
        >
          <span class="track-node" aria-hidden="true">
            <Icon name={entry.axis} />
          </span>

          <p class="label track-dates">
            {languages.map((lang) => (
              <span lang={lang} data-i18n={lang}>
                {monthLabel(entry.start, lang)}
                {' — '}
                {entry.end ? monthLabel(entry.end, lang) : PRESENT[lang]}
              </span>
            ))}
            {entry.freelance && (
              <span class="track-tag">
                <Bilingual es="Freelance" en="Freelance" />
              </span>
            )}
          </p>

          <h3 class="track-role">{entry.role}</h3>
          <p class="track-company">{entry.company}</p>
          <p class="track-note prose-tight">
            <Bilingual es={entry.note.es} en={entry.note.en} />
          </p>

          {/* The discipline, for a screen reader only: sighted readers get it
              from the glyph in the node, and repeating it as visible text on
              every row would be three more words per entry in a 19rem column. */}
          <span class="sr-only">{axisTitle(entry.axis)}</span>
        </li>
      ))
    }
  </ol>

  <a
    class="link track-out track-enter"
    style={`--i:${entries.length + 4}`}
    href={profile.experience.cta.source}
    target="_blank"
    rel="noreferrer noopener"
  >
    <Bilingual es="Ver el perfil completo en LinkedIn" en="See the full profile on LinkedIn" />
    <ExternalArrow />
  </a>
</section>
