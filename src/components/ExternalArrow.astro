---
/**
 * The little diagonal that marks a link as leaving the page.
 *
 * Same drawing rules as `Icon.astro`: no fill, `currentColor` stroke at 1.1,
 * round caps and joins — it is a hairline mark, not a tool mark, so it must
 * never gain weight or colour of its own. `.link:hover .arrow` nudges it.
 *
 * Takes a class so it can also fill the cue slot of an `.axis` row, where the
 * reveal is the row's rather than the link's.
 */
interface Props {
  class?: string;
}

const { class: className } = Astro.props;
---

<svg
  class:list={['arrow', className]}
  width="8"
  height="8"
  viewBox="0 0 8 8"
  fill="none"
  aria-hidden="true"
>
  <path
    d="M1.5 6.5 6.5 1.5M6.5 1.5H2.5M6.5 1.5V5.5"
    stroke="currentColor"
    stroke-width="1.1"
    stroke-linecap="round"
    stroke-linejoin="round"
  />
</svg>
