---
import Bilingual from './Bilingual.astro';

const username = 'limayamil';

// A live SVG keeps the portfolio framework-free and token-free. The palette is
// the site's own warm scale, from an inactive cell to the highest activity.
const graphUrl = new URL(`https://gh-heat.anishroy.com/api/${username}/svg`);
graphUrl.searchParams.set('colors', '2a1a13,743226,a64334,e35342,f2836f');
graphUrl.searchParams.set('transparent', 'true');
graphUrl.searchParams.set('showMonthLabels', 'false');
graphUrl.searchParams.set('showDayLabels', 'false');
graphUrl.searchParams.set('showLegend', 'false');
graphUrl.searchParams.set('padding', '0');
graphUrl.searchParams.set('radius', '2');
graphUrl.searchParams.set('borderWidth', '0');
---

<figure class="github-activity">
  <div class="github-activity-panel">
    <figcaption class="github-activity-head">
      <span class="github-activity-title">
        <svg viewBox="0 0 24 24" width="16" height="16" aria-hidden="true">
          <path
            fill="currentColor"
            d="M12 .7A11.5 11.5 0 0 0 8.36 23.1c.58.1.79-.25.79-.56v-2.23c-3.22.7-3.9-1.36-3.9-1.36-.53-1.34-1.29-1.7-1.29-1.7-1.05-.72.08-.71.08-.71 1.16.08 1.78 1.2 1.78 1.2 1.04 1.77 2.72 1.26 3.38.96.1-.75.4-1.26.74-1.55-2.57-.3-5.27-1.29-5.27-5.69 0-1.26.45-2.28 1.19-3.09-.12-.29-.52-1.46.11-3.05 0 0 .97-.31 3.16 1.18a10.9 10.9 0 0 1 5.76 0c2.2-1.49 3.16-1.18 3.16-1.18.63 1.59.23 2.76.11 3.05.74.81 1.19 1.83 1.19 3.09 0 4.41-2.71 5.39-5.29 5.68.42.36.79 1.06.79 2.14v3.26c0 .31.21.67.8.56A11.5 11.5 0 0 0 12 .7Z"
          ></path>
        </svg>
        <Bilingual es="Actividad en GitHub" en="GitHub activity" />
      </span>
      <span class="label github-activity-meta">
        <Bilingual es="Últimos 12 meses" en="Last 12 months" />
      </span>
    </figcaption>

    <img
      class="github-activity-graph"
      src={graphUrl.toString()}
      width="687"
      height="89"
      loading="lazy"
      decoding="async"
      fetchpriority="low"
      referrerpolicy="no-referrer"
      alt=""
      aria-hidden="true"
    />
  </div>
</figure>
