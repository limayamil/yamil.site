---
import { profile } from '../data/profile';
import { parseGloss } from '../lib/gloss';
import Axes from './Axes.astro';
import Bilingual from './Bilingual.astro';
import Doodle from './Doodle.astro';
import ExternalArrow from './ExternalArrow.astro';
import Icon from './Icon.astro';
import LangToggle from './LangToggle.astro';
import Links from './Links.astro';
import Track from './Track.astro';

const languages = ['es', 'en'] as const;

// The ring goes around the last word, not the whole name — a mark that circles
// everything marks nothing. A single-word name simply gets no ring. Split per
// language: word order and word count both differ between es and en.
const nameByLang = Object.fromEntries(
  languages.map((lang) => {
    const words = profile.name[lang].trim().split(/\s+/);
    const last = words.length > 1 ? words.pop()! : null;
    return [lang, { lead: words.join(' '), last }];
  }),
) as Record<(typeof languages)[number], { lead: string; last: string | null }>;

/**
 * Which glossed term gets the highlighter: the first one in the column, per
 * language. One marker swipe per bio, not one per term — two would read as a
 * legend rather than as someone marking the line that mattered.
 */
const highlighted = Object.fromEntries(
  languages.map((lang) => {
    for (const [p, paragraph] of profile.bio.entries()) {
      const token = parseGloss(paragraph[lang]).findIndex((t) => t.note);
      if (token !== -1) return [lang, `${p}:${token}`];
    }
    return [lang, null];
  }),
) as Record<(typeof languages)[number], string | null>;

/**
 * The experience line splits around its `{company}` token, so the company link
 * lands mid-sentence in whatever position each language puts it. Split at build
 * time — the halves are plain text nodes, never `set:html`.
 */
const { line, company, cta } = profile.experience;
const experienceParts = Object.fromEntries(
  languages.map((lang) => [lang, line[lang].split('{company}')]),
) as Record<(typeof languages)[number], string[]>;

// Rendered at build time so the slot is never empty; motion.ts replaces it
// with the visitor-accurate value on load and keeps it ticking.
const initialTime = new Intl.DateTimeFormat('en-US', {
  hour: '2-digit',
  minute: '2-digit',
  hour12: false,
  timeZone: profile.timezone,
}).format(new Date());
---

{/*
  Two states and one URL, the same shape the work column has:

    bio    — who this is (the default)
    track  — the full record, opened by `#recorrido`

  Both ship in the HTML and `data-view` picks one, exactly the way
  `.projects[data-view]` swaps the bento for a case.

  The column is in three parts, and the split is what lets a fifteen-year
  timeline live in a pinned 100svh box:

    .intro-views  the two views, and the only part that scrolls
    .intro-foot   contact and the local clock — outside the views, so it
                  belongs to neither and survives both

  Contact used to sit at the bottom of the bio, which meant opening the record
  took it off screen. Lifting it out is what makes the footer a constant: the
  views change under it and it does not move, including during the swap, since
  it is a sibling of the element being animated out rather than a child of it.
*/}
<header class="intro" data-intro data-view="bio">
  <div class="intro-views">
    <div class="intro-bio" data-intro-bio>
      <div class="flex flex-col gap-7">
      <div class="enter flex items-start justify-between gap-4" style="--i:0">
        {/* Decorative: the name it sits above already announces who this is. */}
        <img
          class="size-12 lg:size-14"
          src="/logo.png"
          alt=""
          width="384"
          height="384"
          loading="eager"
          decoding="sync"
          fetchpriority="high"
        />
        <LangToggle />
      </div>

      <div class="flex flex-col gap-3">
        {
          languages.map((lang) => (
            <h1
              lang={lang}
              data-i18n={lang}
              class="display enter text-[clamp(2.6rem,4.4vw,3.9rem)]"
              style="--i:1"
            >
              {nameByLang[lang].lead}
              {nameByLang[lang].last && ' '}
              {nameByLang[lang].last && (
                <span class="mark">
                  {nameByLang[lang].last}
                  <Doodle name="oval" class="doodle-enter" />
                </span>
              )}
            </h1>
          ))
        }
        <p class="enter text-[0.9375rem] text-muted" style="--i:2">
          <Bilingual es={profile.role.es} en={profile.role.en} />
        </p>
      </div>

      {/* Each language gets its own copy of the bio: the marked-up terms differ
          per language, so `Bilingual` (which takes plain strings) can't do it. */}
      <div class="bio col-prose enter text-muted" style="--i:3">
        {
          languages.map((lang) => (
            <div lang={lang} data-i18n={lang} class="flex flex-col gap-3.5">
              {profile.bio.map((paragraph, p) => (
                <p class="prose-tight">
                  {parseGloss(paragraph[lang]).map((token, t) =>
                    token.note ? (
                      <button type="button" class="gloss" data-gloss>
                        {token.text}
                        <span class="gloss-note">{token.note}</span>
                        {highlighted[lang] === `${p}:${t}` && (
                          <Doodle name="highlight" class="doodle-enter doodle-wipe" />
                        )}
                      </button>
                    ) : (
                      token.text
                    ),
                  )}
                </p>
              ))}
            </div>
          ))
        }
      </div>

      {/* Where, under what the work is. Not a `bio` paragraph: those run through
          `parseGloss`, which only ever emits text — it has no notion of a link.

          Boxed, because the two rows are one thought: the line says where the
          work is now, the link opens where it has been. Two rows and no
          caption — the copy names its own subject ("Ahora en…"), so a label
          over it would say the word twice and cost the pinned column a row. */}
      <section class="now enter flex flex-col gap-2 text-muted" style="--i:4">
        {
          languages.map((lang) => (
            <p lang={lang} data-i18n={lang} class="now-line prose-tight">
              {/* Decorative, and unlabelled on purpose: the sentence it heads
                  already opens with "Ahora", so a screen reader announcing the
                  dot would say it twice. */}
              <span class="dot" aria-hidden="true" />
              {experienceParts[lang][0]}
              {/* No marker swipe on this one, unlike the same link used to
                  carry. The swipe bleeds 0.26em past the word on each side —
                  that is what makes it read as drawn by hand rather than as a
                  background — and here the word before it is "en", one space
                  away, so the left bleed lands on it and the two collide.
                  The rule the bio already follows says the same thing from the
                  other end: one swipe per column, and the bio has it. */}
              <a class="link-em" href={company.href} target="_blank" rel="noreferrer noopener">
                {company.name}
                <ExternalArrow />
              </a>
              {/* Same `[term](note)` markup the bio uses, run through the same
                  parser — but the marked term here is the whole role title,
                  four words long, where a bio gloss is one. `.gloss` alone
                  won't do: it's an inline-block button, atomic on its line,
                  and four words in the pinned 19rem column would just run
                  off the edge. `.gloss-role` renders it `display: inline`
                  instead, so the title wraps like ordinary text, and its
                  note is a sibling rather than a child — an inline box that
                  wraps has no single box left to hang an absolutely
                  positioned child off, so the note anchors to the paragraph
                  (`.now p`, set `position: relative` for exactly this) and
                  sits under the whole line instead of under one word. */}
              {parseGloss(experienceParts[lang][1]).map((token) =>
                token.note ? (
                  <>
                    <button type="button" class="gloss gloss-role" data-gloss>
                      {token.text}
                    </button>
                    <span class="gloss-note">{token.note}</span>
                  </>
                ) : (
                  token.text
                ),
              )}
            </p>
          ))
        }

        {/* Shaped like an axis row, and deliberately not one: it carries no
            `data-axis`, so the capability panel never answers to it and it
            drives no slot. The borrowed shape is the point — it reads as
            another thing in the column you can open, and now it is one: the
            href is `#recorrido`, which is the left column's own route.

            Which is also why the cue is the axes' chevron rather than the
            diagonal arrow it used to carry. Nothing leaves the page here. */}
        <a class="axis axis-link" href={cta.href} data-track-open>
          <Icon name="track" class="axis-icon" />
          <span class="axis-title"><Bilingual es={cta.label.es} en={cta.label.en} /></span>
          <svg class="axis-cue" width="8" height="8" viewBox="0 0 8 8" fill="none" aria-hidden="true">
            <path
              d="M2.75 1.25 5.75 4 2.75 6.75"
              stroke="currentColor"
              stroke-width="1.1"
              stroke-linecap="round"
              stroke-linejoin="round"></path>
          </svg>
        </a>
      </section>
    </div>

      {/* Stays in the bio view rather than moving to the footer: the record has
          a legend of its own naming the same three disciplines, and two copies
          of that control on screen at once would be one too many. */}
      <div class="enter mt-12 lg:mt-0" style="--i:6">
        <Axes />
      </div>
    </div>

    <Track />
  </div>

  <div class="intro-foot enter" style="--i:7">
    <div class="flex flex-col gap-3">
      <h2 class="label"><Bilingual es="Contacto" en="Contact" /></h2>

      {/* The note rides on the same line as the links so its arrow can reach
          back into the row. Laid out as a sibling of the list rather than
          inside it: the list is the semantic set of contact links, and a
          decorative aside is not one of them.

          Aria-hidden: it points at links that are right there and already
          labelled. Read aloud, "escribime, Email, LinkedIn" is just noise. */}
      <div class="contact-row">
        <Links />
        <p class="note hand" aria-hidden="true">
          <Doodle name="arrowLeft" class="doodle-enter" />
          <Bilingual es={profile.contactNote.es} en={profile.contactNote.en} />
        </p>
      </div>
    </div>

    <p class="flex items-center gap-2 text-[0.8125rem] text-faint">
      <span>{profile.location}</span>
      <span aria-hidden="true">—</span>
      <time data-clock data-timezone={profile.timezone} class="tabular-nums">
        {initialTime}
      </time>
      <span
        data-weather
        data-weather-lat={profile.weather.lat}
        data-weather-lon={profile.weather.lon}
        class="items-center gap-1 tabular-nums"
        style="display: none"
      >
        <span aria-hidden="true">—</span>
        <span data-weather-icon aria-hidden="true"></span>
        <span data-weather-temp></span>
      </span>
    </p>
  </div>
</header>
