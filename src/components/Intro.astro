---
import { profile } from '../data/profile';
import { parseGloss } from '../lib/gloss';
import Axes from './Axes.astro';
import Bilingual from './Bilingual.astro';
import LangToggle from './LangToggle.astro';
import Links from './Links.astro';

const languages = ['es', 'en'] as const;

// Rendered at build time so the slot is never empty; motion.ts replaces it
// with the visitor-accurate value on load and keeps it ticking.
const initialTime = new Intl.DateTimeFormat('en-US', {
  hour: '2-digit',
  minute: '2-digit',
  hour12: false,
  timeZone: profile.timezone,
}).format(new Date());
---

<header class="intro">
  <div class="flex flex-col gap-7">
    <div class="enter flex items-start justify-between gap-4" style="--i:0">
      {/* Decorative: the name it sits above already announces who this is. */}
      <img
        class="size-12 lg:size-14"
        src="/logo.png"
        alt=""
        width="384"
        height="384"
        loading="eager"
        decoding="sync"
        fetchpriority="high"
      />
      <LangToggle />
    </div>

    <div class="flex flex-col gap-3">
      <h1 class="display enter text-[clamp(2.6rem,4.4vw,3.9rem)]" style="--i:1">
        {profile.name}
      </h1>
      <p class="enter text-[0.9375rem] text-muted" style="--i:2">
        <Bilingual es={profile.role.es} en={profile.role.en} />
      </p>
    </div>

    {/* Each language gets its own copy of the bio: the marked-up terms differ
        per language, so `Bilingual` (which takes plain strings) can't do it. */}
    <div class="bio enter max-w-[38ch] text-muted" style="--i:3">
      {
        languages.map((lang) => (
          <div lang={lang} data-i18n={lang} class="flex flex-col gap-3.5">
            {profile.bio.map((paragraph) => (
              <p class="prose-tight">
                {parseGloss(paragraph[lang]).map((token) =>
                  token.note ? (
                    <button type="button" class="gloss" data-gloss>
                      {token.text}
                      <span class="gloss-note">{token.note}</span>
                    </button>
                  ) : (
                    token.text
                  ),
                )}
              </p>
            ))}
          </div>
        ))
      }
    </div>

    {
      profile.available.is && (
        <p class="enter flex items-center gap-2.5 text-[0.8125rem]" style="--i:4">
          <span class="dot" />
          <Bilingual es={profile.available.label.es} en={profile.available.label.en} />
        </p>
      )
    }
  </div>

  <div class="enter mt-12 flex flex-col gap-8 lg:mt-0" style="--i:5">
    <Axes />

    <div class="flex flex-col gap-3">
      <h2 class="label"><Bilingual es="Contacto" en="Contact" /></h2>
      <Links />
    </div>

    <p class="flex items-center gap-2 text-[0.8125rem] text-faint">
      <span>{profile.location}</span>
      <span aria-hidden="true">—</span>
      <time data-clock data-timezone={profile.timezone} class="tabular-nums">
        {initialTime}
      </time>
      <span
        data-weather
        data-weather-lat={profile.weather.lat}
        data-weather-lon={profile.weather.lon}
        class="items-center gap-1 tabular-nums"
        style="display: none"
      >
        <span aria-hidden="true">—</span>
        <span data-weather-icon aria-hidden="true"></span>
        <span data-weather-temp></span>
      </span>
    </p>
  </div>
</header>
