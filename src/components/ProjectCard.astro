---
/**
 * One tile in the bento grid.
 *
 * The whole tile is a single `<a>` — nothing else inside it is interactive, so
 * the axis line and the chevron are spans, not controls. That anchor is also
 * the router: its `href` is the case's hash, so a plain click changes the URL
 * and `motion.ts` reacts to `hashchange`. Nothing here calls `preventDefault`,
 * which is why ctrl-click and middle-click still open a real new tab.
 *
 * Unlike the old stacked card, the media is the *background*: it is absolutely
 * positioned and the copy sits on top of it. That makes the scrim inside
 * `.tile-media` load-bearing rather than decorative — see the Bento section of
 * global.css.
 */
import type { CollectionEntry } from 'astro:content';
import { profile } from '../data/profile';
import { CARD_IMAGE_SIZES, cardImage } from '../lib/project-media';
import Bilingual from './Bilingual.astro';

interface Props {
  project: CollectionEntry<'projects'>['data'];
  slug: string;
  index: number;
}

const { project, slug, index } = Astro.props;
const { title, summary, axis, tier, shape, year, poster, coverTint, video, detail } = project;

// The tile borrows the case gallery as a quiet preview. Keep the poster first
// (it is the meaningful initial frame) and avoid rendering a duplicate when a
// gallery happens to include it again.
const slides = [poster, ...detail.gallery.map((shot) => shot.src)].filter(
  (src, slideIndex, all) => all.indexOf(src) === slideIndex,
);

// The discipline goes by its English name in both languages, same as the axis
// rows in the left column.
const axisTitle = profile.capabilities.find((c) => c.icon === axis)?.title ?? axis;
// Only the first tile competes for initial bandwidth. The remaining posters
// are responsive but lazy, and future slideshow frames do not get a `src`
// until `motion.ts` promotes them shortly before their dissolve.
const eager = index === 0;
---

<article
  class="tile"
  data-reveal
  data-tier={tier}
  data-shape={shape}
  data-axis={axis}
  data-slug={slug}
  style={`--i:${index};--tile-tint:${coverTint.join(' ')}`}
>
  <a class="tile-link" href={`#caso/${slug}`}>
    <div
      class="tile-media case-media"
      data-case-media
      {...video ? {} : { 'data-placeholder': '' }}
    >
      {
        slides.map((src, slideIndex) => {
          const image = cardImage(src);
          const active = slideIndex === 0;

          return (
            <div
              class="case-media-frame"
              data-media-slide
              data-active={active ? 'true' : 'false'}
              aria-hidden="true"
            >
              <img
                {...active
                  ? { src: image.src, srcset: image.srcset, sizes: CARD_IMAGE_SIZES }
                  : {
                      'data-src': image.src,
                      'data-srcset': image.srcset,
                      'data-sizes': CARD_IMAGE_SIZES,
                    }}
                alt=""
                width="1920"
                height="1080"
                loading={active && eager ? 'eager' : 'lazy'}
                decoding={active && eager ? 'sync' : 'async'}
                fetchpriority={active && eager ? 'high' : 'auto'}
              />
            </div>
          );
        })
      }
      {
        video && (
          <video
            src={video}
            poster={poster}
            muted
            loop
            playsinline
            preload="none"
            aria-hidden="true"
            tabindex="-1"
          />
        )
      }
    </div>

    <div class="tile-body">
      <p class="label tile-axis">
        <span>{axisTitle}</span>
        <span class="tile-year">{year}</span>
      </p>
      <h3 class="tile-title"><Bilingual es={title.es} en={title.en} /></h3>
      <p class="tile-summary prose-tight">
        <Bilingual es={summary.es} en={summary.en} />
      </p>
    </div>

    {/* Same chevron as `.axis-cue` — the site's one "there is more here" mark. */}
    <svg
      class="tile-cue"
      width="8"
      height="8"
      viewBox="0 0 8 8"
      fill="none"
      aria-hidden="true"
    >
      <path
        d="M2.75 1.25 5.75 4 2.75 6.75"
        stroke="currentColor"
        stroke-width="1.1"
        stroke-linecap="round"
        stroke-linejoin="round"></path>
    </svg>
  </a>
</article>
