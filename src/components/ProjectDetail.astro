---
/**
 * The case view — the second state of the right-hand column.
 *
 * Every case is rendered server-side and ships hidden inside the page. There is
 * no fetch and no client-side template: `motion.ts` only flips the `hidden`
 * attribute. `hidden` rather than a class, deliberately, so a closed case is
 * out of the accessibility tree, and so `#caso/slug` degrades to "nothing
 * happens" instead of "half a page" when JS is off.
 *
 * `.case-hero` is the FLIP target: it is the element that grows out of the
 * rect of whichever tile was clicked.
 */
import type { CollectionEntry } from 'astro:content';
import Bilingual from './Bilingual.astro';
import Doodle from './Doodle.astro';
import ExternalArrow from './ExternalArrow.astro';

interface Props {
  project: CollectionEntry<'projects'>['data'];
  slug: string;
  prev?: CollectionEntry<'projects'>;
  next?: CollectionEntry<'projects'>;
}

const { project, slug, prev, next } = Astro.props;
const { title, year, roles, poster, video, detail } = project;

const slides = [poster, ...detail.gallery.map((shot) => shot.src)].filter(
  (src, slideIndex, all) => all.indexOf(src) === slideIndex,
);

const outcomeSectionIndex = detail.sections.length - 1;

---

<article class="case" data-case={slug} hidden>
  <button type="button" class="case-back case-enter" style="--i:0" data-case-back>
    <svg width="14" height="14" viewBox="0 0 8 8" fill="none" aria-hidden="true">
      <path
        d="M5.25 1.25 2.25 4l3 2.75"
        stroke="currentColor"
        stroke-width="1.1"
        stroke-linecap="round"
        stroke-linejoin="round"></path>
    </svg>
    <Bilingual es="Volver a los trabajos" en="Back to work" />
  </button>

  <div class="case-head-row">
    <header class="case-head case-enter" style="--i:1">
      <p class="label case-kicker">
        <span><Bilingual es="Caso" en="Case study" /></span>
        <span>{year}</span>
      </p>
      <h2 class="case-title display"><Bilingual es={title.es} en={title.en} /></h2>
      <p class="case-lead prose-tight">
        <Bilingual es={detail.lead.es} en={detail.lead.en} />
      </p>
      <ul class="case-roles">
        {
          roles.map((role) => (
            <li>
              <Bilingual es={role.es} en={role.en} />
            </li>
          ))
        }
      </ul>
    </header>

    {
      detail.clientLogos.length > 0 && (
        <div class="case-head-logos case-enter" style="--i:1" aria-hidden="true">
          {detail.clientLogos.map((logo) => (
            <img class="case-head-logo" src={logo.src} alt="" loading="lazy" decoding="async" />
          ))}
        </div>
      )
    }
  </div>

  <div class="case-hero-wrap">
    <div
      class="case-hero case-media"
      data-case-hero
      data-case-media
      {...video ? {} : { 'data-placeholder': '' }}
    >
      {
        slides.map((src, slideIndex) => (
          <div
            class="case-media-frame"
            data-media-slide
            data-active={slideIndex === 0 ? 'true' : 'false'}
            aria-hidden="true"
          >
            <img
              {...slideIndex === 0 ? { src } : { 'data-src': src }}
              alt=""
              width="1920"
              height="1080"
              loading="lazy"
              decoding="async"
              fetchpriority="low"
            />
          </div>
        ))
      }
      {
        video && (
          <video src={video} poster={poster} muted loop playsinline preload="none" aria-hidden="true" tabindex="-1" />
        )
      }
    </div>

    {
      detail.heroNote && (
        <p class="case-hero-note hand case-enter" style="--i:2">
          <Doodle name="arrowLeft" class="doodle-enter" />
          <Bilingual es={detail.heroNote.es} en={detail.heroNote.en} />
        </p>
      )
    }
  </div>

  {
    detail.metrics.length > 0 && (
      <ul class="case-metrics case-enter" style="--i:2">
        {detail.metrics.map((metric, metricIndex) => (
          <li>
            {/* Counts up from zero on open — job 11 in `motion.ts`. The value is
                parsed out of the text, so `+40%` counts the 40 and keeps both
                the sign and the unit. */}
            <span class:list={['case-metric-value', metricIndex === 0 && 'case-metric-mark']}>
              <span data-counter>{metric.value}</span>
              {metricIndex === 0 && <Doodle name="oval" class="doodle-enter" />}
            </span>
            <span class="label case-metric-label">
              <Bilingual es={metric.label.es} en={metric.label.en} />
            </span>
          </li>
        ))}
      </ul>
    )
  }

  <div class="case-body case-enter" style="--i:3">
    {
      detail.sections.length > 0 && (
        <div class="case-sections">
          {detail.sections.map((section, sectionIndex) => (
            <section class:list={['case-section', sectionIndex === outcomeSectionIndex && 'case-section-outcome']}>
              <div class="case-section-head">
                <span class="label case-section-index">
                  {String(sectionIndex + 1).padStart(2, '0')}
                </span>
                <h3 class="case-heading">
                  {sectionIndex === outcomeSectionIndex ? (
                    <span class="case-outcome-mark">
                      <Bilingual es={section.heading.es} en={section.heading.en} />
                      <Doodle name="highlight" class="doodle-enter doodle-wipe" />
                    </span>
                  ) : (
                    <Bilingual es={section.heading.es} en={section.heading.en} />
                  )}
                </h3>
              </div>
              {section.body.map((paragraph) => (
                <p class="prose-tight">
                  <Bilingual es={paragraph.es} en={paragraph.en} />
                </p>
              ))}
              {section.note && (
                <p class="case-section-note hand">
                  <Doodle name="arrowUp" class="doodle-enter" />
                  <Bilingual es={section.note.es} en={section.note.en} />
                </p>
              )}
            </section>
          ))}
        </div>
      )
    }

    {
      detail.facts.length > 0 && (
        <aside class="case-facts-card">
          <p class="case-facts-title hand">
            <Bilingual es="Ficha técnica" en="Technical notes" />
          </p>
          <dl class="case-facts">
            {detail.facts.map((fact) => (
              <div>
                <dt class="label">
                  <Bilingual es={fact.label.es} en={fact.label.en} />
                </dt>
                <dd>
                  <Bilingual es={fact.value.es} en={fact.value.en} />
                </dd>
              </div>
            ))}
          </dl>
        </aside>
      )
    }
  </div>

  {
    detail.gallery.length > 0 && (
      <div class="case-gallery case-enter" style="--i:4">
        {detail.gallery.map((shot) => (
          <figure class:list={['case-shot', shot.wide && 'case-shot-wide']}>
            {/* `alt` cannot hold two languages the way `Bilingual` does, and a
                second hidden <img> would still be fetched. So it ships in the
                served language and `initLang` swaps it — the one attribute on
                the page that JS translates. */}
            <img
              src={shot.src}
              alt={shot.alt.es}
              data-alt-es={shot.alt.es}
              data-alt-en={shot.alt.en}
              width="1920"
              height="1080"
              loading="lazy"
              decoding="async"
            />
            {shot.caption && (
              <figcaption class="case-caption">
                <Bilingual es={shot.caption.es} en={shot.caption.en} />
              </figcaption>
            )}
            {shot.note && (
              <p class="case-shot-note hand">
                <Doodle name="arrowLeft" class="doodle-enter" />
                <Bilingual es={shot.note.es} en={shot.note.en} />
              </p>
            )}
          </figure>
        ))}
      </div>
    )
  }

  {
    detail.link && (
      <a
        class="link case-link case-enter"
        style="--i:5"
        href={detail.link.href}
        target="_blank"
        rel="noreferrer noopener"
      >
        <Bilingual es={detail.link.label.es} en={detail.link.label.en} />
        <ExternalArrow />
      </a>
    )
  }

  <nav class="case-nav case-enter" style="--i:6">
    {
      prev ? (
        <a class="case-step" href={`#caso/${prev.id}`} rel="prev">
          <span class="label">
            <Bilingual es="Anterior" en="Previous" />
          </span>
          <span class="case-step-title">
            <Bilingual es={prev.data.title.es} en={prev.data.title.en} />
          </span>
        </a>
      ) : (
        <span />
      )
    }
    {
      next && (
        <a class="case-step case-step-next" href={`#caso/${next.id}`} rel="next">
          <span class="label">
            <Bilingual es="Siguiente" en="Next" />
          </span>
          <span class="case-step-title">
            <Bilingual es={next.data.title.es} en={next.data.title.en} />
          </span>
        </a>
      )
    }
  </nav>
</article>
