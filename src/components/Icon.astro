---
/**
 * The three capability glyphs, drawn by hand rather than pulled from a library
 * — a dependency for three shapes would break the "no framework, one script"
 * posture the rest of the site keeps.
 *
 * Same drawing rules as the external-link arrow in `Links.astro`: no fill,
 * `currentColor` stroke, hairline weight, round caps and joins.
 */
interface Props {
  name: 'engineering' | 'motion' | 'ops';
  class?: string;
}

const { name, class: className } = Astro.props;
---

<svg
  class={className}
  width="16"
  height="16"
  viewBox="0 0 16 16"
  fill="none"
  stroke="currentColor"
  stroke-width="1.1"
  stroke-linecap="round"
  stroke-linejoin="round"
  aria-hidden="true"
>
  {/* Angle brackets around a node: the design object, held by the code. */}
  {
    name === 'engineering' && (
      <Fragment>
        <path d="M5.9 3.9 2.4 8l3.5 4.1" />
        <path d="M10.1 3.9 13.6 8l-3.5 4.1" />
        <circle cx="8" cy="8" r="1.6" />
      </Fragment>
    )
  }

  {/* Two keyframes on a timeline — the shape of an ease, not a play button. */}
  {
    name === 'motion' && (
      <Fragment>
        <path d="M2.5 8 4.6 5.9 6.7 8 4.6 10.1z" />
        <path d="M9.3 8 11.4 5.9 13.5 8 11.4 10.1z" />
        <path d="M6.7 8h2.6" />
      </Fragment>
    )
  }

  {/* One trigger branching into two outcomes: a workflow. */}
  {
    name === 'ops' && (
      <Fragment>
        <circle cx="3.2" cy="8" r="1.5" />
        <circle cx="12.8" cy="4.4" r="1.5" />
        <circle cx="12.8" cy="11.6" r="1.5" />
        <path d="M4.7 8h2.6" />
        <path d="M7.3 8V5.4a1 1 0 0 1 1-1h3" />
        <path d="M7.3 8v2.6a1 1 0 0 0 1 1h3" />
      </Fragment>
    )
  }
</svg>
