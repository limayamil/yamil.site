---
/**
 * The filter row above the bento grid.
 *
 * The three axis buttons are read out of `profile.capabilities`, not written
 * here — this row *is* the "En qué soy bueno" list from the left column, seen
 * from the work side, and it carries the same hairline glyph so the connection
 * reads without a caption. A project's `axis` field is the same key as a
 * capability's `icon`, which is what makes the join possible at all.
 *
 * State lives in `aria-pressed`, exactly like `.lang-option` — the visual state
 * and the announced state are the same attribute, so they cannot drift.
 */
import type { CollectionEntry } from 'astro:content';
import { profile } from '../data/profile';
import Bilingual from './Bilingual.astro';
import Icon from './Icon.astro';

interface Props {
  projects: CollectionEntry<'projects'>[];
}

const { projects } = Astro.props;

const countFor = (axis: string) => projects.filter((p) => p.data.axis === axis).length;
---

<div class="filters" data-filters>
  <ul>
    <li>
      <button type="button" class="filter" data-filter-set="all" aria-pressed="true">
        <span class="filter-label"><Bilingual es="Todo" en="All" /></span>
        <span class="filter-count">{projects.length}</span>
      </button>
    </li>
    {
      profile.capabilities.map((capability) => (
        <li>
          <button
            type="button"
            class="filter"
            data-filter-set={capability.icon}
            aria-pressed="false"
          >
            <Icon name={capability.icon} class="filter-icon" />
            <span class="filter-label">{capability.title}</span>
            <span class="filter-count">{countFor(capability.icon)}</span>
          </button>
        </li>
      ))
    }
  </ul>
</div>
